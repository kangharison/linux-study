config PCI_DRA7XX	# [한국어] TI DRA7xx 공통 결합
	tristate	# [한국어] 프롬프트 없는 tristate — 이를 select 하는 쪽의 모듈/내장 선택을 따른다

config PCI_DRA7XX_HOST	# [한국어] DRA7xx 호스트 모드
	tristate "TI DRA7xx PCIe controller (host mode)"	# [한국어] DRA7xx 호스트 모드 — 사용자에게 보이는 항목 이름
	depends on SOC_DRA7XX || COMPILE_TEST	# [한국어] TI DRA7xx이거나 컴파일 검증 목적
	depends on OF && HAS_IOMEM && TI_PIPE3	# [한국어] TI PIPE3 PHY까지 있어야 SerDes가 동작한다
	depends on PCI_MSI	# [한국어] MSI 도메인이 있어야 한다. NVMe가 I/O 큐마다 완료 벡터를 받는 전제
	select PCIE_DW_HOST	# [한국어] 루트 콤플렉스 동작 계층을 함께 빌드. NVMe가 하위에 열거되려면 필요하다
	select PCI_DRA7XX	# [한국어] DRA7xx 공통 결합 코드를 함께 빌드
	default y if SOC_DRA7XX	# [한국어] DRA7xx SoC에서는 기본으로 켠다
	help
	  Enables support for the PCIe controller in the DRA7xx SoC to work in
	  host mode. There are two instances of PCIe controller in DRA7xx.
	  This controller can work either as EP or RC. In order to enable
	  host-specific features PCI_DRA7XX_HOST must be selected and in order
	  to enable device-specific features PCI_DRA7XX_EP must be selected.
	  This uses the DesignWare core.

config PCI_DRA7XX_EP	# [한국어] DRA7xx 엔드포인트 모드
	tristate "TI DRA7xx PCIe controller (endpoint mode)"	# [한국어] DRA7xx 엔드포인트 모드 — 사용자에게 보이는 항목 이름
	depends on SOC_DRA7XX || COMPILE_TEST	# [한국어] TI DRA7xx이거나 컴파일 검증 목적
	depends on OF && HAS_IOMEM && TI_PIPE3	# [한국어] TI PIPE3 PHY까지 있어야 SerDes가 동작한다
	depends on PCI_ENDPOINT	# [한국어] 엔드포인트 프레임워크가 있어야 EPC로 등록할 수 있다
	select PCIE_DW_EP	# [한국어] 엔드포인트 동작 계층을 함께 빌드
	select PCI_DRA7XX	# [한국어] DRA7xx 공통 결합 코드를 함께 빌드
	help
	  Enables support for the PCIe controller in the DRA7xx SoC to work in
	  endpoint mode. There are two instances of PCIe controller in DRA7xx.
	  This controller can work either as EP or RC. In order to enable
	  host-specific features PCI_DRA7XX_HOST must be selected and in order
	  to enable device-specific features PCI_DRA7XX_EP must be selected.
	  This uses the DesignWare core.

# ARM32 platforms use hook_fault_code() and cannot support loadable module.
config PCI_KEYSTONE	# [한국어] TI Keystone 공통 결합(ARM32 내장 전용 경로)
	bool	# [한국어] 프롬프트 없는 bool — 사용자 메뉴에 뜨지 않고 벤더 항목이 select 로만 켜는 내부 심볼

# On non-ARM32 platforms, loadable module can be supported.
config PCI_KEYSTONE_TRISTATE	# [한국어] 같은 결합의 모듈 가능 변형. ARM32가 아닌 플랫폼에서 쓰인다
	tristate	# [한국어] 프롬프트 없는 tristate — 이를 select 하는 쪽의 모듈/내장 선택을 따른다

config PCI_KEYSTONE_HOST	# [한국어] Keystone 호스트 모드
	tristate "TI Keystone PCIe controller (host mode)"	# [한국어] Keystone 호스트 모드 — 사용자에게 보이는 항목 이름
	depends on ARCH_KEYSTONE || ARCH_K3 || COMPILE_TEST	# [한국어] TI Keystone/K3이거나 컴파일 검증 목적
	depends on PCI_MSI	# [한국어] MSI 도메인이 있어야 한다. NVMe가 I/O 큐마다 완료 벡터를 받는 전제
	select PCIE_DW_HOST	# [한국어] 루트 콤플렉스 동작 계층을 함께 빌드. NVMe가 하위에 열거되려면 필요하다
	select PCI_KEYSTONE if ARM	# [한국어] ARM32에서는 내장 전용 심볼을 켠다. hook_fault_code() 사용 때문에 모듈이 될 수 없다
	select PCI_KEYSTONE_TRISTATE if !ARM	# [한국어] ARM32가 아니면 모듈 가능 심볼을 켠다
	help
	  Enables support for the PCIe controller in the Keystone SoC to
	  work in host mode. The PCI controller on Keystone is based on
	  DesignWare hardware and therefore the driver re-uses the
	  DesignWare core functions to implement the driver.

config PCI_KEYSTONE_EP	# [한국어] Keystone 엔드포인트 모드
	tristate "TI Keystone PCIe controller (endpoint mode)"	# [한국어] Keystone 엔드포인트 모드 — 사용자에게 보이는 항목 이름
	depends on ARCH_KEYSTONE || ARCH_K3 || COMPILE_TEST	# [한국어] TI Keystone/K3이거나 컴파일 검증 목적
	depends on PCI_ENDPOINT	# [한국어] 엔드포인트 프레임워크가 있어야 EPC로 등록할 수 있다
	select PCIE_DW_EP	# [한국어] 엔드포인트 동작 계층을 함께 빌드
	select PCI_KEYSTONE if ARM	# [한국어] ARM32에서는 내장 전용 심볼을 켠다. hook_fault_code() 사용 때문에 모듈이 될 수 없다
	select PCI_KEYSTONE_TRISTATE if !ARM	# [한국어] ARM32가 아니면 모듈 가능 심볼을 켠다
	help

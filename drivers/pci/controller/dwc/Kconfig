	depends on OF	# [한국어] 레지스터 창과 인터럽트 배선을 디바이스 트리에서 읽는다
	depends on PCI_ENDPOINT	# [한국어] 엔드포인트 프레임워크가 있어야 EPC로 등록할 수 있다
	select PCIE_DW_EP	# [한국어] 엔드포인트 동작 계층을 함께 빌드
	select PCIE_ROCKCHIP_DW	# [한국어] Rockchip DWC 공통 결합 코드를 함께 빌드
	help
	  Enables support for the DesignWare PCIe controller in the
	  Rockchip SoC (except RK3399) to work in endpoint mode.

config PCI_EXYNOS	# [한국어] Samsung Exynos 컨트롤러
	tristate "Samsung Exynos PCIe controller"	# [한국어] Samsung Exynos 컨트롤러 — 사용자에게 보이는 항목 이름
	depends on ARCH_EXYNOS || COMPILE_TEST	# [한국어] Samsung Exynos이거나 컴파일 검증 목적일 때만 노출
	depends on PCI_MSI	# [한국어] MSI 도메인이 있어야 한다. NVMe가 I/O 큐마다 완료 벡터를 받는 전제
	select PCIE_DW_HOST	# [한국어] 루트 콤플렉스 동작 계층을 함께 빌드. NVMe가 하위에 열거되려면 필요하다
	help
	  Enables support for the PCIe controller in the Samsung Exynos SoCs
	  to work in host mode. The PCI controller is based on the DesignWare
	  hardware and therefore the driver re-uses the DesignWare core
	  functions to implement the driver.

config PCIE_FU740	# [한국어] SiFive FU740(HiFive Unmatched) 컨트롤러. RISC-V 보드에서 NVMe를 올리는 대표 경로
	bool "SiFive FU740 PCIe controller"	# [한국어] SiFive FU740(HiFive Unmatched) 컨트롤러. RISC-V 보드에서 NVMe를 올리는 대표 경로 — 사용자에게 보이는 항목 이름
	depends on PCI_MSI	# [한국어] MSI 도메인이 있어야 한다. NVMe가 I/O 큐마다 완료 벡터를 받는 전제
	depends on ARCH_SIFIVE || COMPILE_TEST	# [한국어] SiFive SoC이거나 컴파일 검증 목적일 때만 노출
	select PCIE_DW_HOST	# [한국어] 루트 콤플렉스 동작 계층을 함께 빌드. NVMe가 하위에 열거되려면 필요하다
	help
	  Say Y here if you want PCIe controller support for the SiFive
	  FU740.

config PCIE_UNIPHIER	# [한국어] Socionext UniPhier 호스트 모드
	bool "Socionext UniPhier PCIe controller (host mode)"	# [한국어] Socionext UniPhier 호스트 모드 — 사용자에게 보이는 항목 이름
	depends on ARCH_UNIPHIER || COMPILE_TEST	# [한국어] Socionext UniPhier이거나 컴파일 검증 목적
	depends on OF && HAS_IOMEM	# [한국어] DT와 MMIO 접근이 모두 필요
	depends on PCI_MSI	# [한국어] MSI 도메인이 있어야 한다. NVMe가 I/O 큐마다 완료 벡터를 받는 전제
	select PCIE_DW_HOST	# [한국어] 루트 콤플렉스 동작 계층을 함께 빌드. NVMe가 하위에 열거되려면 필요하다
	help
	  Say Y here if you want PCIe host controller support on UniPhier SoCs.
	  This driver supports LD20 and PXs3 SoCs.

config PCIE_UNIPHIER_EP	# [한국어] Socionext UniPhier 엔드포인트 모드
	bool "Socionext UniPhier PCIe controller (endpoint mode)"	# [한국어] Socionext UniPhier 엔드포인트 모드 — 사용자에게 보이는 항목 이름
	depends on ARCH_UNIPHIER || COMPILE_TEST	# [한국어] Socionext UniPhier이거나 컴파일 검증 목적

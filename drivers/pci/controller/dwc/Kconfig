	select PCIE_DW_HOST	# [한국어] 루트 콤플렉스 동작 계층을 함께 빌드. NVMe가 하위에 열거되려면 필요하다
	select PHY_TEGRA194_P2U	# [한국어] Tegra194의 P2U(PIPE to UPHY) PHY 드라이버가 있어야 링크가 선다
	select PCIE_TEGRA194	# [한국어] Tegra194 공통 결합 코드를 함께 빌드
	help

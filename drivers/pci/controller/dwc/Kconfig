config PCIE_TEGRA194_HOST	# [한국어] Tegra194 이후 호스트 모드
	tristate "NVIDIA Tegra194 (and later) PCIe controller (host mode)"	# [한국어] Tegra194 이후 호스트 모드 — 사용자에게 보이는 항목 이름

# ============================================================================
# [한국어 설명] Synopsys DesignWare PCIe 컨트롤러 설정 (controller/dwc/Kconfig)
#
# === 파일의 역할 ===
# DesignWare(DWC) PCIe IP를 채용한 SoC들의 호스트/엔드포인트 드라이버 빌드
# 여부를 정한다. DWC는 상용 SoC에서 가장 널리 쓰이는 PCIe IP라 이 파일이 PCI
# 트리에서 가장 큰 Kconfig이며, 58개 항목 대부분이 같은 패턴을 따른다:
# 프롬프트 없는 벤더 공통 심볼 하나 + 호스트 모드 + 엔드포인트 모드.
#
# === 전체 아키텍처에서의 위치 ===
# drivers/pci/controller/Kconfig -> [이 파일]
# 계층 구조는 세 단이다:
#   PCIE_DW            공통 코어(iATU 주소 변환, 링크 상태 판정)
#   PCIE_DW_HOST / _EP 동작 모드(루트 콤플렉스 / 엔드포인트)
#   <벤더>_HOST / _EP  전원·클럭·PHY·리셋 등 SoC 고유 결합
# 사용자는 맨 아래 벤더 항목만 고르고, 그것이 위 두 단을 select 로 끌어온다.
# NVMe 관점에서 이 계층은 링크를 올리고 iATU를 프로그래밍하는 층이다. iATU가
# CPU 물리 주소를 PCI 버스 주소로 옮겨 주어야 BAR0 접근과 DMA가 성립한다.
#
# === 타 모듈과의 연결 ===
# - controller/dwc/Makefile: 선택 결과를 오브젝트로 번역.
# - drivers/phy/: 대부분 항목이 SerDes PHY 드라이버와 짝을 이뤄야 링크가 선다.
# - drivers/pci/endpoint/: _EP 항목들이 PCI_ENDPOINT에 의존하는 이유.
# - drivers/pci/msi/: PCI_MSI 의존이 29곳에 걸쳐 있다. NVMe가 큐마다 벡터를
#   받으려면 컨트롤러가 MSI 도메인을 제공해야 하기 때문이다.
#
# === 주요 함수/구조체 요약 ===
# - PCIE_DW        : 공통 코어(내부 심볼). 모든 파생이 결국 이것을 켠다.
# - PCIE_DW_HOST   : 루트 콤플렉스 동작(내부 심볼). NVMe 열거의 전제.
# - PCIE_DW_EP     : 엔드포인트 동작(내부 심볼).
# - PCIE_DW_DEBUGFS: 링크 속도/폭과 오류 카운터를 런타임에 관측.
# ============================================================================

menu "DesignWare-based PCIe controllers"	# [한국어] DesignWare IP 기반 컨트롤러 메뉴 시작
	depends on PCI	# [한국어] PCI 코어 없이는 호스트 브리지를 등록할 대상이 없다

config PCIE_DW	# [한국어] DWC 공통 코어. 모든 파생이 결국 이것을 켠다
	bool	# [한국어] 프롬프트 없는 bool — 사용자 메뉴에 뜨지 않고 벤더 항목이 select 로만 켜는 내부 심볼

config PCIE_DW_DEBUGFS	# [한국어] debugfs 노출. 링크 속도/폭과 오류 카운터를 런타임에 들여다볼 때
	bool "DesignWare PCIe debugfs entries"	# [한국어] debugfs 노출. 링크 속도/폭과 오류 카운터를 런타임에 들여다볼 때 — 사용자에게 보이는 항목 이름
	depends on DEBUG_FS	# [한국어] debugfs 파일시스템이 있어야 노드를 만들 수 있다
	depends on PCIE_DW_HOST || PCIE_DW_EP	# [한국어] 호스트든 엔드포인트든 DWC 동작 계층 하나는 켜져 있어야 관측할 대상이 생긴다
	help
	  Say Y here to enable debugfs entries for the PCIe controller. These
	  entries provide various debug features related to the controller and
	  expose the RAS DES capabilities such as Silicon Debug, Error Injection
	  and Statistical Counters.

config PCIE_DW_HOST	# [한국어] 루트 콤플렉스 동작 계층. NVMe 열거의 전제
	bool	# [한국어] 프롬프트 없는 bool — 사용자 메뉴에 뜨지 않고 벤더 항목이 select 로만 켜는 내부 심볼
	select PCIE_DW	# [한국어] DWC 공통 코어(iATU, 링크 판정)를 함께 빌드
	select IRQ_MSI_LIB	# [한국어] MSI 도메인 구성 헬퍼를 끌어온다
	select PCI_HOST_COMMON	# [한국어] DT 파싱과 브리지 등록의 공통 절차를 재사용

config PCIE_DW_EP	# [한국어] 엔드포인트 동작 계층
	bool	# [한국어] 프롬프트 없는 bool — 사용자 메뉴에 뜨지 않고 벤더 항목이 select 로만 켜는 내부 심볼
	select PCIE_DW	# [한국어] DWC 공통 코어(iATU, 링크 판정)를 함께 빌드

config PCIE_AL	# [한국어] Amazon Annapurna Labs 컨트롤러. AWS Graviton 계열
	bool "Amazon Annapurna Labs PCIe controller"	# [한국어] Amazon Annapurna Labs 컨트롤러. AWS Graviton 계열 — 사용자에게 보이는 항목 이름
	depends on OF && (ARM64 || COMPILE_TEST)	# [한국어] DT가 필요하고, ARM64이거나 컴파일 검증 목적일 때만 노출
	depends on PCI_MSI	# [한국어] MSI 도메인이 있어야 한다. NVMe가 I/O 큐마다 완료 벡터를 받는 전제
	select PCIE_DW_HOST	# [한국어] 루트 콤플렉스 동작 계층을 함께 빌드. NVMe가 하위에 열거되려면 필요하다
	select PCI_ECAM	# [한국어] config space 접근이 표준 ECAM 규약을 따르므로 그 구현을 함께 빌드
	help
	  Say Y here to enable support of the Amazon's Annapurna Labs PCIe
	  controller IP on Amazon SoCs. The PCIe controller uses the DesignWare
	  core plus Annapurna Labs proprietary hardware wrappers. This is
	  required only for DT-based platforms. ACPI platforms with the
	  Annapurna Labs PCIe controller don't need to enable this.

config PCIE_AMD_MDB	# [한국어] AMD MDB Versal2 컨트롤러
	bool "AMD MDB Versal2 PCIe controller"	# [한국어] AMD MDB Versal2 컨트롤러 — 사용자에게 보이는 항목 이름
	depends on OF && (ARM64 || COMPILE_TEST)	# [한국어] DT가 필요하고, ARM64이거나 컴파일 검증 목적일 때만 노출
	depends on PCI_MSI	# [한국어] MSI 도메인이 있어야 한다. NVMe가 I/O 큐마다 완료 벡터를 받는 전제
	select PCIE_DW_HOST	# [한국어] 루트 콤플렉스 동작 계층을 함께 빌드. NVMe가 하위에 열거되려면 필요하다
	help
	  Say Y here if you want to enable PCIe controller support on AMD
	  Versal2 SoCs. The AMD MDB Versal2 PCIe controller is based on
	  DesignWare IP and therefore the driver re-uses the DesignWare
	  core functions to implement the driver.

config PCI_MESON	# [한국어] Amlogic Meson 컨트롤러
	tristate "Amlogic Meson PCIe controller"	# [한국어] Amlogic Meson 컨트롤러 — 사용자에게 보이는 항목 이름
	default m if ARCH_MESON	# [한국어] Amlogic 플랫폼에서는 기본값을 모듈로 둔다
	depends on PCI_MSI	# [한국어] MSI 도메인이 있어야 한다. NVMe가 I/O 큐마다 완료 벡터를 받는 전제
	select PCIE_DW_HOST	# [한국어] 루트 콤플렉스 동작 계층을 함께 빌드. NVMe가 하위에 열거되려면 필요하다
	help
	  Say Y here if you want to enable PCI controller support on Amlogic
	  SoCs. The PCI controller on Amlogic is based on DesignWare hardware
	  and therefore the driver re-uses the DesignWare core functions to
	  implement the driver.

config PCIE_ANDES_QILAI	# [한국어] Andes QiLai RISC-V SoC 컨트롤러
	tristate "Andes QiLai PCIe controller"	# [한국어] Andes QiLai RISC-V SoC 컨트롤러 — 사용자에게 보이는 항목 이름
	depends on ARCH_ANDES || COMPILE_TEST	# [한국어] Andes SoC이거나 컴파일 검증 목적일 때만 노출
	depends on PCI_MSI	# [한국어] MSI 도메인이 있어야 한다. NVMe가 I/O 큐마다 완료 벡터를 받는 전제
	select PCIE_DW_HOST	# [한국어] 루트 콤플렉스 동작 계층을 함께 빌드. NVMe가 하위에 열거되려면 필요하다
	help
	  Say Y here to enable PCIe controller support on Andes QiLai SoCs,
	  which operate in Root Complex mode. The Andes QiLai SoC PCIe
	  controller is based on DesignWare IP and therefore the driver
	  re-uses the DesignWare core functions to implement the driver.

config PCIE_ARTPEC6	# [한국어] Axis ARTPEC-6 공통 결합
	bool	# [한국어] 프롬프트 없는 bool — 사용자 메뉴에 뜨지 않고 벤더 항목이 select 로만 켜는 내부 심볼

config PCIE_ARTPEC6_HOST	# [한국어] ARTPEC-6 호스트 모드
	bool "Axis ARTPEC-6 PCIe controller (host mode)"	# [한국어] ARTPEC-6 호스트 모드 — 사용자에게 보이는 항목 이름
	depends on MACH_ARTPEC6 || COMPILE_TEST	# [한국어] Axis ARTPEC-6이거나 컴파일 검증 목적
	depends on PCI_MSI	# [한국어] MSI 도메인이 있어야 한다. NVMe가 I/O 큐마다 완료 벡터를 받는 전제
	select PCIE_DW_HOST	# [한국어] 루트 콤플렉스 동작 계층을 함께 빌드. NVMe가 하위에 열거되려면 필요하다
	select PCIE_ARTPEC6	# [한국어] ARTPEC-6 공통 결합 코드를 함께 빌드
	help
	  Enables support for the PCIe controller in the ARTPEC-6 SoC to work in
	  host mode. This uses the DesignWare core.

config PCIE_ARTPEC6_EP	# [한국어] ARTPEC-6 엔드포인트 모드
	bool "Axis ARTPEC-6 PCIe controller (endpoint mode)"	# [한국어] ARTPEC-6 엔드포인트 모드 — 사용자에게 보이는 항목 이름
	depends on MACH_ARTPEC6 || COMPILE_TEST	# [한국어] Axis ARTPEC-6이거나 컴파일 검증 목적
	depends on PCI_ENDPOINT	# [한국어] 엔드포인트 프레임워크가 있어야 EPC로 등록할 수 있다
	select PCIE_DW_EP	# [한국어] 엔드포인트 동작 계층을 함께 빌드
	select PCIE_ARTPEC6	# [한국어] ARTPEC-6 공통 결합 코드를 함께 빌드
	help
	  Enables support for the PCIe controller in the ARTPEC-6 SoC to work in
	  endpoint mode. This uses the DesignWare core.

config PCIE_ESWIN	# [한국어] ESWIN EIC7700 SoC 컨트롤러
	tristate "ESWIN PCIe controller"	# [한국어] ESWIN EIC7700 SoC 컨트롤러 — 사용자에게 보이는 항목 이름
	depends on ARCH_ESWIN || COMPILE_TEST	# [한국어] ESWIN SoC이거나 컴파일 검증 목적일 때만 노출
	depends on PCI_MSI	# [한국어] MSI 도메인이 있어야 한다. NVMe가 I/O 큐마다 완료 벡터를 받는 전제
	select PCIE_DW_HOST	# [한국어] 루트 콤플렉스 동작 계층을 함께 빌드. NVMe가 하위에 열거되려면 필요하다
	help
	  Say Y here if you want PCIe controller support for the ESWIN SoCs.
	  The PCIe controller in ESWIN SoCs is based on DesignWare hardware, and
	  works only in host mode.

config PCI_IMX6	# [한국어] NXP i.MX6/7/8 공통 결합
	bool	# [한국어] 프롬프트 없는 bool — 사용자 메뉴에 뜨지 않고 벤더 항목이 select 로만 켜는 내부 심볼

config PCI_IMX6_HOST	# [한국어] i.MX6/7/8 호스트 모드. 임베디드 보드에서 NVMe를 붙이는 흔한 경로
	bool "Freescale i.MX6/7/8 PCIe controller (host mode)"	# [한국어] i.MX6/7/8 호스트 모드. 임베디드 보드에서 NVMe를 붙이는 흔한 경로 — 사용자에게 보이는 항목 이름
	depends on ARCH_MXC || COMPILE_TEST	# [한국어] NXP i.MX이거나 컴파일 검증 목적
	depends on PCI_MSI	# [한국어] MSI 도메인이 있어야 한다. NVMe가 I/O 큐마다 완료 벡터를 받는 전제
	select PCIE_DW_HOST	# [한국어] 루트 콤플렉스 동작 계층을 함께 빌드. NVMe가 하위에 열거되려면 필요하다
	select PCI_IMX6	# [한국어] i.MX6 공통 결합 코드를 함께 빌드
	help
	  Enables support for the PCIe controller in the i.MX SoCs to
	  work in Root Complex mode. The PCI controller on i.MX is based
	  on DesignWare hardware and therefore the driver re-uses the
	  DesignWare core functions to implement the driver.

config PCI_IMX6_EP	# [한국어] i.MX6/7/8 엔드포인트 모드
	bool "Freescale i.MX6/7/8 PCIe controller (endpoint mode)"	# [한국어] i.MX6/7/8 엔드포인트 모드 — 사용자에게 보이는 항목 이름
	depends on ARCH_MXC || COMPILE_TEST	# [한국어] NXP i.MX이거나 컴파일 검증 목적
	depends on PCI_ENDPOINT	# [한국어] 엔드포인트 프레임워크가 있어야 EPC로 등록할 수 있다
	select PCIE_DW_EP	# [한국어] 엔드포인트 동작 계층을 함께 빌드
	select PCI_IMX6	# [한국어] i.MX6 공통 결합 코드를 함께 빌드
	help
	  Enables support for the PCIe controller in the i.MX SoCs to
	  work in endpoint mode. The PCI controller on i.MX is based
	  on DesignWare hardware and therefore the driver re-uses the
	  DesignWare core functions to implement the driver.

config PCI_LAYERSCAPE	# [한국어] NXP Layerscape 호스트 모드
	tristate "Freescale Layerscape PCIe controller (host mode)"	# [한국어] NXP Layerscape 호스트 모드 — 사용자에게 보이는 항목 이름
	depends on OF && (ARM || ARCH_LAYERSCAPE || COMPILE_TEST)	# [한국어] ARM32 또는 Layerscape이거나 컴파일 검증 목적
	depends on PCI_MSI	# [한국어] MSI 도메인이 있어야 한다. NVMe가 I/O 큐마다 완료 벡터를 받는 전제
	select PCIE_DW_HOST	# [한국어] 루트 콤플렉스 동작 계층을 함께 빌드. NVMe가 하위에 열거되려면 필요하다
	select MFD_SYSCON	# [한국어] 시스템 제어 레지스터를 regmap으로 공유해서 접근한다
	help
	  Say Y here if you want to enable PCIe controller support on Layerscape
	  SoCs to work in Host mode.
	  This controller can work either as EP or RC. The RCW[HOST_AGT_PEX]
	  determines which PCIe controller works in EP mode and which PCIe
	  controller works in RC mode.

config PCI_LAYERSCAPE_EP	# [한국어] NXP Layerscape 엔드포인트 모드
	bool "Freescale Layerscape PCIe controller (endpoint mode)"	# [한국어] NXP Layerscape 엔드포인트 모드 — 사용자에게 보이는 항목 이름
	depends on OF && (ARM || ARCH_LAYERSCAPE || COMPILE_TEST)	# [한국어] ARM32 또는 Layerscape이거나 컴파일 검증 목적
	depends on PCI_ENDPOINT	# [한국어] 엔드포인트 프레임워크가 있어야 EPC로 등록할 수 있다
	select PCIE_DW_EP	# [한국어] 엔드포인트 동작 계층을 함께 빌드
	help
	  Say Y here if you want to enable PCIe controller support on Layerscape
	  SoCs to work in Endpoint mode.
	  This controller can work either as EP or RC. The RCW[HOST_AGT_PEX]
	  determines which PCIe controller works in EP mode and which PCIe
	  controller works in RC mode.

config PCI_HISI	# [한국어] HiSilicon Hip05/Hip06 서버 SoC 컨트롤러
	depends on OF && (ARM64 || COMPILE_TEST)	# [한국어] DT가 필요하고, ARM64이거나 컴파일 검증 목적일 때만 노출
	bool "HiSilicon Hip05 and Hip06 SoCs PCIe controller"	# [한국어] HiSilicon Hip05/Hip06 서버 SoC 컨트롤러 — 사용자에게 보이는 항목 이름
	depends on PCI_MSI	# [한국어] MSI 도메인이 있어야 한다. NVMe가 I/O 큐마다 완료 벡터를 받는 전제
	select PCIE_DW_HOST	# [한국어] 루트 콤플렉스 동작 계층을 함께 빌드. NVMe가 하위에 열거되려면 필요하다
	select PCI_HOST_COMMON	# [한국어] DT 파싱과 브리지 등록의 공통 절차를 재사용
	help
	  Say Y here if you want PCIe controller support on HiSilicon
	  Hip05 and Hip06 SoCs

config PCIE_KIRIN	# [한국어] HiSilicon Kirin 모바일 SoC 컨트롤러
	depends on OF && (ARM64 || COMPILE_TEST)	# [한국어] DT가 필요하고, ARM64이거나 컴파일 검증 목적일 때만 노출
	tristate "HiSilicon Kirin PCIe controller"	# [한국어] HiSilicon Kirin 모바일 SoC 컨트롤러 — 사용자에게 보이는 항목 이름
	depends on PCI_MSI	# [한국어] MSI 도메인이 있어야 한다. NVMe가 I/O 큐마다 완료 벡터를 받는 전제
	select PCIE_DW_HOST	# [한국어] 루트 콤플렉스 동작 계층을 함께 빌드. NVMe가 하위에 열거되려면 필요하다
	select REGMAP_MMIO	# [한국어] MMIO 기반 regmap으로 시스템 제어 레지스터를 다룬다
	help
	  Say Y here if you want PCIe controller support
	  on HiSilicon Kirin series SoCs.


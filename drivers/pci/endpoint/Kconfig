#
# ============================================================================
# [한국어 설명] PCIe 엔드포인트 프레임워크 설정 (drivers/pci/endpoint/Kconfig)
#
# === 파일의 역할 ===
# 리눅스가 PCIe 링크에서 호스트가 아니라 "장치측"으로 동작할지를 정한다.
# 평소 NVMe를 다루는 방향(리눅스=호스트, SSD=엔드포인트)과 정확히 반대이며,
# 여기서 리눅스는 상대 호스트에게 BAR와 config space 헤더를 노출하는 쪽이 된다.
# SoC의 PCIe 컨트롤러가 엔드포인트 모드를 지원해야 의미가 있다.
#
# === 전체 아키텍처에서의 위치 ===
# drivers/pci/Kconfig -> [이 파일] -> endpoint/functions/Kconfig
# 구성 요소는 세 층이다: EPC(컨트롤러 추상화), EPF(기능 추상화), 그리고 둘을
# 사용자에게 묶게 해 주는 configfs. 링크 순서상 이 코어가 컨트롤러/기능
# 드라이버보다 먼저 초기화돼야 하므로 상위 Makefile이 순서를 강제한다.
#
# === 타 모듈과의 연결 ===
# - drivers/pci/endpoint/Makefile: 선택 결과를 오브젝트로 번역.
# - drivers/pci/controller/dwc/*-ep.c: EPC 측 실제 하드웨어 구현.
# - drivers/pci/endpoint/functions/: 이 코어 위에 얹히는 기능 드라이버들.
#
# === 주요 함수/구조체 요약 ===
# - PCI_ENDPOINT            : EPC/EPF 라이브러리 전체의 마스터 스위치.
# - PCI_ENDPOINT_CONFIGFS   : 기능 생성과 컨트롤러 결합을 사용자에게 여는 통로.
# - PCI_ENDPOINT_MSI_DOORBELL: 호스트가 전용 BAR에 쓰면 엔드포인트가 MSI를
#   받는 도어벨 구조. 완료 통지를 역방향으로 보낼 때 쓰인다.
# ============================================================================
#
# PCI Endpoint Support
#

menu "PCI Endpoint"	# [한국어] 엔드포인트 메뉴 시작

config PCI_ENDPOINT	# [한국어] 엔드포인트 라이브러리 마스터 스위치
	bool "PCI Endpoint Support"	# [한국어] bool — 코어 라이브러리라 모듈로 빼지 않는다
	depends on HAVE_PCI	# [한국어] PCI 하드웨어 지원이 있는 아키텍처에서만 의미가 있다
	help
	   Enable this configuration option to support configurable PCI
	   endpoint. This should be enabled if the platform has a PCI
	   controller that can operate in endpoint mode.

	   Enabling this option will build the endpoint library, which
	   includes endpoint controller library and endpoint function
	   library.

	   If in doubt, say "N" to disable Endpoint support.

config PCI_ENDPOINT_CONFIGFS	# [한국어] configfs 인터페이스 스위치
	bool "PCI Endpoint Configfs Support"	# [한국어] bool — 코어에 함께 링크된다
	depends on PCI_ENDPOINT	# [한국어] 엔드포인트 코어가 없으면 결합할 대상이 없다
	select CONFIGFS_FS	# [한국어] configfs 파일시스템을 강제로 켠다. /sys/kernel/config/pci_ep/ 트리가 여기 얹힌다
	help
	   This will enable the configfs entry that can be used to
	   configure the endpoint function and used to bind the
	   function with an endpoint controller.

config PCI_ENDPOINT_MSI_DOORBELL	# [한국어] MSI 도어벨 스위치
	bool "PCI Endpoint MSI Doorbell Support"	# [한국어] bool — 코어 기능의 일부
	depends on PCI_ENDPOINT && GENERIC_MSI_IRQ	# [한국어] 엔드포인트 코어와 범용 MSI IRQ 프레임워크가 모두 필요하다
	help
	  This enables the EP's MSI interrupt controller to function as a
	  doorbell. The RC can trigger doorbell in EP by writing data to a
	  dedicated BAR, which the EP maps to the controller's message address.

source "drivers/pci/endpoint/functions/Kconfig"	# [한국어] 기능 드라이버 하위 메뉴를 이 자리에 삽입

endmenu	# [한국어] 엔드포인트 메뉴 끝
